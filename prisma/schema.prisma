generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id              String            @id @default(cuid())
  name            String
  city            String?
  yandexUrl       String?
  dgisUrl         String?
  googleUrl       String?
  externalId      String?
  templateId      String?
  // How to steer a happy customer's review. ALL = show every configured
  // platform (default). FEWER_REVIEWS / LOWER_RATING = highlight the one
  // platform that needs help most, based on the latest scraped RatingHistory.
  reviewStrategy  ReviewStrategy    @default(ALL)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  analyticsEvents AnalyticsEvent[]
  template        QuestionTemplate? @relation(fields: [templateId], references: [id])
  shortLinks      ShortLink[]
  surveyResponses SurveyResponse[]
  ratingHistory   RatingHistory[]
  managers        User[]            @relation("BranchManagers")
}

enum ReviewStrategy {
  ALL
  FEWER_REVIEWS
  LOWER_RATING
}

model QuestionTemplate {
  id        String     @id @default(cuid())
  name      String
  minScore  Float      @default(4.0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  branches  Branch[]
  questions Question[]
}

model Question {
  id         String            @id @default(cuid())
  text       String
  order      Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  templateId String?
  template   QuestionTemplate? @relation(fields: [templateId], references: [id])
}

model SurveyResponse {
  id              String   @id @default(cuid())
  clientId        String
  // Each dealId can receive exactly one submission. Race-protects against
  // a client double-clicking "submit" — both requests reach the handler,
  // both pass the 6-month findFirst check, only one INSERT wins; the other
  // gets a Prisma P2002 error which the handler turns into 429.
  dealId          String   @unique
  averageScore    Float
  answers         Json
  comment         String?
  createdAt       DateTime @default(now())
  branchId        String?
  responsibleName String?
  branch          Branch?  @relation(fields: [branchId], references: [id])

  // Close-the-loop on negatives. Only set for responses below the negative
  // threshold (averageScore < 4.5); positive responses leave it null.
  complaintStatus ComplaintStatus?
  resolutionNote  String?
  resolvedAt      DateTime?

  @@index([clientId])
  @@index([complaintStatus])
}

enum ComplaintStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique
  url       String
  createdAt DateTime @default(now())
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([code])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  // ADMIN sees everything and manages users. MANAGER sees only the branches
  // assigned via the BranchManagers relation. Existing users default to ADMIN
  // so nothing changes for them on migration.
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  branches  Branch[] @relation("BranchManagers")
}

enum UserRole {
  ADMIN
  MANAGER
}

model AnalyticsEvent {
  id        String        @id @default(cuid())
  type      AnalyticsType
  target    String?
  branchId  String?
  createdAt DateTime      @default(now())
  branch    Branch?       @relation(fields: [branchId], references: [id])

  @@index([type])
  @@index([branchId])
}

model SentSurvey {
  id              String   @id @default(cuid())
  dealId          String   @unique
  clientId        String?
  responsibleName String?
  createdAt       DateTime @default(now())
  // Follow-up for "opened but not completed": store the survey link so the
  // reminder job can re-send it, and track whether/when a reminder went out.
  surveyUrl       String?
  followUpSentAt  DateTime?
  followUpCount   Int      @default(0)
}

model B24Webhook {
  id          String   @id @default(cuid())
  // Bitrix24 user ID this webhook acts as (e.g. "706", "847").
  // The /api/b24/webhook flow picks the webhook whose userId matches
  // the deal's ASSIGNED_BY_ID, falling back to others on CANCELED errors.
  userId      String   @unique
  displayName String?
  url         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RatingHistory {
  id          String   @id @default(cuid())
  branchId    String
  service     String   // "yandex", "2gis", "google"
  rating      Float
  reviewCount Int
  createdAt   DateTime @default(now())
  branch      Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId, service])
}

enum AnalyticsType {
  VIEW
  CLICK
}
