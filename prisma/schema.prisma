generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id              String            @id @default(cuid())
  name            String
  city            String?
  yandexUrl       String?
  dgisUrl         String?
  googleUrl       String?
  // Distinct from googleUrl (which is the customer-facing review-page link).
  // googleSearchQuery is the query/URL the Apps Script syncer hands to Serper
  // to look up *this exact* Google Maps card — best filled with a CID URL
  // (https://www.google.com/maps?cid=<…>) so Serper can't return a different
  // business with a similar name. Falls back to the branch name when null.
  googleSearchQuery String?
  externalId      String?
  templateId      String?
  // How to steer a happy customer's review. ALL = show every configured
  // platform (default). FEWER_REVIEWS / LOWER_RATING = highlight the one
  // platform that needs help most, based on the latest scraped RatingHistory.
  reviewStrategy  ReviewStrategy    @default(ALL)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  analyticsEvents AnalyticsEvent[]
  template        QuestionTemplate? @relation(fields: [templateId], references: [id])
  shortLinks      ShortLink[]
  surveyResponses SurveyResponse[]
  ratingHistory   RatingHistory[]
  managers        User[]            @relation("BranchManagers")
  cities          City[]
}

// A customer-facing city choice for CRM survey links. When the
// "city selection" scenario is enabled, a link sent via CRM first asks the
// client to pick their city; the attached branch then drives the survey
// (questions + review-map links). Independent of the per-branch QR codes.
model City {
  id        String   @id @default(cuid())
  name      String
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReviewStrategy {
  ALL
  FEWER_REVIEWS
  LOWER_RATING
}

model QuestionTemplate {
  id        String     @id @default(cuid())
  name      String
  minScore  Float      @default(4.0)
  // Customisable survey-slide texts. Null → the app's built-in default.
  startTitle         String?
  startSubtitle      String?
  lowTitle           String?
  lowSubtitle        String?
  commentPlaceholder String?
  successTitle       String?
  successPositive    String?
  successNegative    String?
  reviewPrompt       String?
  // How often a client may retake the survey, in hours. 0 = unlimited.
  surveyFrequencyHours Int    @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  branches  Branch[]
  questions Question[]
}

model Question {
  id         String            @id @default(cuid())
  text       String
  order      Int               @default(0)
  // Question type: RATING (1-5 stars, default) | NPS (0-10) | CHOICE (pick one
  // of `options`) | YESNO | TEXT (free text). Only RATING answers feed the
  // averageScore / negative threshold; the rest are stored as extra answers.
  type       String            @default("RATING")
  // Choices for a CHOICE question (ignored for other types).
  options    String[]          @default([])
  // Conditional display by the running rating score: null = always shown,
  // "negative" = only when the score is below the template threshold,
  // "positive" = only at/above it.
  showIf     String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  templateId String?
  template   QuestionTemplate? @relation(fields: [templateId], references: [id])

  // Questions are almost always fetched by template (survey render, field
  // mapping, scoring) — index the FK so those lookups don't seq-scan.
  @@index([templateId])
}

model SurveyResponse {
  id              String   @id @default(cuid())
  clientId        String
  // Each dealId can receive exactly one submission. Race-protects against
  // a client double-clicking "submit" — both requests reach the handler,
  // both pass the 6-month findFirst check, only one INSERT wins; the other
  // gets a Prisma P2002 error which the handler turns into 429.
  dealId          String   @unique
  averageScore    Float
  answers         Json
  comment         String?
  // Optional contact phone the customer leaves on the negative-feedback step.
  phone           String?
  // AI auto-tags derived from the comment text (Claude). E.g.
  // ["доставка","цена"]. Empty when there's no comment / AI isn't configured.
  tags            String[] @default([])
  createdAt       DateTime @default(now())
  branchId        String?
  responsibleName String?
  branch          Branch?  @relation(fields: [branchId], references: [id])

  // CRM entity the survey was dispatched for, so we can deep-link back into
  // Bitrix24 and label notifications. "deal" | "lead" | null (QR/direct).
  entityType      String?

  // Close-the-loop on negatives. Only set for responses below the negative
  // threshold (averageScore < 4.5); positive responses leave it null.
  complaintStatus ComplaintStatus?
  resolutionNote  String?
  resolvedAt      DateTime?

  @@index([clientId])
  @@index([complaintStatus])
  // createdAt is the dominant filter/sort across dashboard, results and export;
  // branchId backs the per-branch role scope and aggregates.
  @@index([createdAt])
  @@index([branchId])
}

enum ComplaintStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique
  url       String
  createdAt DateTime @default(now())
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([code])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  // ADMIN sees everything and manages users. MANAGER sees only the branches
  // assigned via the BranchManagers relation. Existing users default to ADMIN
  // so nothing changes for them on migration.
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  branches  Branch[] @relation("BranchManagers")
}

enum UserRole {
  ADMIN
  MANAGER
}

model AnalyticsEvent {
  id        String        @id @default(cuid())
  type      AnalyticsType
  target    String?
  branchId  String?
  // De-dup key for "unique" counting: one VIEW per survey token, one CLICK
  // per token+target. Null for legacy/untokened events (always inserted).
  dedupeKey String?       @unique
  createdAt DateTime      @default(now())
  branch    Branch?       @relation(fields: [branchId], references: [id])

  @@index([type])
  @@index([branchId])
  // Dashboard/report funnel filters events by createdAt window.
  @@index([createdAt])
}

model SentSurvey {
  id              String   @id @default(cuid())
  dealId          String   @unique
  clientId        String?
  responsibleName String?
  createdAt       DateTime @default(now())
  // Follow-up for "opened but not completed": store the survey link so the
  // reminder job can re-send it, and track whether/when a reminder went out.
  surveyUrl       String?
  followUpSentAt  DateTime?
  followUpCount   Int      @default(0)

  // Quiet-hours deferral (no client sends 20:00-09:00 МСК). A dispatch created
  // at night stores deliverAfter = next 09:00 МСК and deliveredAt = null; the
  // cron job delivers it in the morning and stamps deliveredAt. Daytime
  // dispatches get deliveredAt right away. Rows that predate this feature were
  // backfilled with deliveredAt = createdAt.
  deliveredAt     DateTime?
  deliverAfter    DateTime?

  // Backs the follow-up job's scan (followUpSentAt IS NULL + createdAt window).
  @@index([followUpSentAt, createdAt])
  // Backs the deferred-delivery scan (deliveredAt IS NULL + deliverAfter due).
  @@index([deliverAfter])
}

// Lightweight audit trail of administrator actions (status changes, settings
// edits, user CRUD). Append-only; no FK to User so a deleted user's history
// is preserved (username is snapshotted at write time).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String?
  action    String   // machine key, e.g. "complaint.status", "settings.update"
  target    String?  // affected object id / name
  details   String?  // human-readable summary
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model B24Webhook {
  id          String   @id @default(cuid())
  // Bitrix24 user ID this webhook acts as (e.g. "706", "847").
  // The /api/b24/webhook flow picks the webhook whose userId matches
  // the deal's ASSIGNED_BY_ID, falling back to others on CANCELED errors.
  userId      String   @unique
  displayName String?
  url         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RatingHistory {
  id          String   @id @default(cuid())
  branchId    String
  service     String   // "yandex", "2gis", "google"
  rating      Float
  reviewCount Int
  createdAt   DateTime @default(now())
  branch      Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId, service])
}

enum AnalyticsType {
  VIEW
  CLICK
}
